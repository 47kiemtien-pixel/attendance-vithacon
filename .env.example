NODE_ENV=production
HOST=0.0.0.0
PORT=5000

ATTENDANCE_DATA_DRIVER=postgres
DATABASE_URL=postgres://attendance_user:change_me@postgres:5432/attendance_system

PGHOST=postgres
PGPORT=5432
PGDATABASE=attendance_system
PGUSER=attendance_user
PGPASSWORD=change_me

AUTH_REQUIRED=true
JWT_SECRET=replace-with-a-long-random-secret

# Use comma separated origins in production. Example:
# CORS_ORIGIN=https://app.yourdomain.com,https://admin.yourdomain.com
CORS_ORIGIN=*

# Optional: point desktop app to public API
# ATTENDANCE_API_URL=https://api.yourdomain.com/api
